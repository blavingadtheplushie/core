# =====================================================================
#  BLAVINGAD — configuration (copy this file to .env)
#  Everything is optional except the model. Each missing integration
#  simply disables the matching tools.
# =====================================================================

AGENT_NAME=BLAVINGAD
AGENT_LANGUAGE=English
TZ=Europe/Paris

# ---------- 🔐 Vaultwarden vault (recommended) ----------
# Every secret below (except Slack) can live in Vaultwarden:
#   - either leave the variable EMPTY and create, in the VAULT_FOLDER
#     folder, an item named after it (e.g. CLOUDFLARE_API_TOKEN);
#   - or use a reference: CLOUDFLARE_API_TOKEN=vault://Cloudflare/api_token
#     (field: password by default, username, notes, uri, totp, or a custom field).
# The URL must use HTTPS (required by the Bitwarden CLI).
VAULT_URL=https://vault.example.com
# API key of the bot's account: Vaultwarden → Settings → Security → Keys → API key
VAULT_CLIENT_ID=user.xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
VAULT_CLIENT_SECRET=
# (alternative to the API key: VAULT_EMAIL)
VAULT_EMAIL=
VAULT_MASTER_PASSWORD=
VAULT_FOLDER=BLAVINGAD
# Where vault_save writes. Empty = the bot's personal vault. If an organization
# policy removes individual vaults (or you share secrets through an org), set
# the collection the bot can EDIT (name or id; the organization only if names
# are ambiguous). With a single shared collection it is picked automatically.
VAULT_ORGANIZATION=
VAULT_COLLECTION=
# Internal certificate authority (optional, path inside the container)
VAULT_CA_CERT=

# ---------- 🧠 Model (any OpenAI- or Anthropic-compatible API) ----------
# OpenAI      : https://api.openai.com/v1
# OpenRouter  : https://openrouter.ai/api/v1          (LLM_MODEL=anthropic/claude-sonnet-4.5 …)
# Ollama      : http://host.docker.internal:11434/v1  (LLM_API_KEY can be empty)
# Anthropic-style APIs (set LLM_API_STYLE=anthropic):
# Anthropic   : https://api.anthropic.com/v1          (LLM_MODEL=claude-sonnet-4-5 …)
# Gateways speaking the Anthropic Messages format (LiteLLM, Snowflake, proxies): their /v1 URL
# Not sure of the model name? Settings → Model lists what the endpoint offers.
# LiteLLM / vLLM / Groq / Mistral / DeepSeek : their /v1 URL
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
LLM_MODEL=anthropic/claude-sonnet-4.5
# Fast/cheap model for reflection and summaries (default: LLM_MODEL)
LLM_FAST_MODEL=
LLM_CONTEXT_TOKENS=128000
LLM_MAX_TOKENS=8192
LLM_TEMPERATURE=0.4
# API format: openai (POST {base}/chat/completions) or anthropic (POST {base}/messages).
# Also switchable from the dashboard (Settings → Model).
LLM_API_STYLE=openai
# Extra HTTP headers some providers require, "Name: value; Name2: value".
# Snowflake Cortex with a programmatic access token, for example:
# LLM_HEADERS=X-Snowflake-Authorization-Token-Type: PROGRAMMATIC_ACCESS_TOKEN
LLM_HEADERS=

# ---------- 🧬 Embeddings (semantic memory) ----------
# Empty = keyword search only. Otherwise, an /embeddings model:
# OpenAI: text-embedding-3-small · Ollama: nomic-embed-text
EMBED_MODEL=
EMBED_BASE_URL=
EMBED_API_KEY=

# ---------- 💬 Slack (Socket Mode) ----------
# Create the app with slack-app-manifest.yml (see README).
SLACK_BOT_TOKEN=xoxb-...
SLACK_APP_TOKEN=xapp-...
# Slack IDs that are always admin (👑 profile, locked). Other access is managed
# in the dashboard → Access, or by asking the agent.
SLACK_ADMINS=U0123ABCD
# Channel for announcements, self-review reports and out-of-Slack approvals
SLACK_HOME_CHANNEL=C0123ABCD

# ---------- 🔎 Web search ----------
EXA_API_KEY=

# ---------- 🐙 GitHub (its own account) ----------
# Token (fine-grained or classic: repo, workflow, pages) of the agent's GitHub account
GITHUB_TOKEN=
GITHUB_USER=
GIT_AUTHOR_NAME=BLAVINGAD
GIT_AUTHOR_EMAIL=
# Repository it pushes its self-improvements to (owner/repo). Create it empty first.
SELF_REPO=
SELF_REPO_BRANCH=main

# ---------- 📬 Email (IMAP + SMTP) ----------
IMAP_HOST=
IMAP_PORT=993
IMAP_TLS=true
IMAP_USER=
IMAP_PASSWORD=
SMTP_HOST=
SMTP_PORT=587
# starttls (587) | tls (465) | plain
SMTP_MODE=starttls
# SMTP_USER / SMTP_PASSWORD: default to the IMAP ones
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=
EMAIL_FROM_NAME=BLAVINGAD
EMAIL_POLL_SECONDS=90

# ---------- 🚀 Deployments ----------
# Token permissions: Pages/Workers as needed, plus for the tunnel
# Account › Cloudflare Tunnel: Edit, Zone › DNS: Edit, Zone › Zone: Read
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
# Cloudflare Tunnel: the connector token (Zero Trust › Networks › Tunnels), or
# just its id. Leave both empty and ask the agent "set up the Cloudflare
# tunnel": it creates one and starts cloudflared itself.
CLOUDFLARE_TUNNEL_TOKEN=
CLOUDFLARE_TUNNEL_ID=
# Docker: enabled if /var/run/docker.sock is mounted (force with DOCKER_DEPLOY=true/false)
DEPLOY_HOST=my-server.example.com
DEPLOY_NETWORK=blavingad-apps
DEPLOY_PORT_BASE=9100
# With Traefik (see docker-compose.yml): apps at https://<app>.<DEPLOY_DOMAIN>
DEPLOY_TRAEFIK=false
DEPLOY_DOMAIN=

# ---------- 🖥️ Web interface + OIDC (Pocket ID or other) ----------
PUBLIC_URL=https://blavingad.example.com
OIDC_ISSUER=https://id.example.com
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# Restrict access (empty = any account from the OIDC provider)
OIDC_ALLOWED_EMAILS=me@example.com
OIDC_ALLOWED_GROUPS=
# Local development only: password login
ADMIN_PASSWORD=
